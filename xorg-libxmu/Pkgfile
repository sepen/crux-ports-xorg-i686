# Description: xorg lib libXmu
# URL: https://xorg.freedesktop.org
# Maintainer: CRUX Xorg Team, xorg-ports at crux dot nu
# Arch Maintainer: Jose Beneyto, sepen at crux-arm dot nu
# Depends on: xorg-libxext xorg-libxt

name=xorg-libxmu
version=1.3.0
release=1
source=(https://www.x.org/releases/individual/lib/libXmu-$version.tar.xz)

build() {
    cd libXmu-$version

    CFLAGS+=' -Wno-error=pointer-to-int-cast -Wno-error=int-to-pointer-cast ' \
    ./configure --prefix=/usr

    make V=1
    make DESTDIR=$PKG install

    rm $PKG/usr/share/doc/libXmu/{Xmu.xml,xlogo.svg}
    find $PKG/usr/share -type d -delete
}
